---
import FaceIcon from "@images/face-icon.avif";
import { Image } from "astro:assets";
---

<section class="relative pb-[100px] mt-40">
	<Image
		src={FaceIcon}
		alt="Face Icon"
		fetchpriority="high"
		layout="constrained"
		class="w-40 h-40 rounded-full absolute -top-32 left-10 -z-10"
	/>
	<h1 class="text-4xl lg:text-7xl font-bold bg-[#fefbf6]">Han Htet Aung</h1>
	<p class="text-sm lg:text-base">software developer | GMT+7</p>
</section>
