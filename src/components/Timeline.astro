---
const {
	date,
	title,
	description,
	color,
	timeColor,
	titleColor,
	descriptionColor,
} = Astro.props;
---

<li
	class="relative -ms-1.5 flex items-start gap-4 lg:ms-0 lg:block lg:gap-0 lg:-mt-1.5"
>
	<span
		class={`size-3 shrink-0 rounded-full lg:block lg:shrink ${color}`}
	></span>
	<div class="my-4">
		<time
			class={`text-xs/none font-medium border-4 p-2 ${timeColor} border-[#232322]`}
		>
			{date}
		</time>

		<h3
			class={`text-lg font-semibold border-4 p-2 ${titleColor} border-[#232322]`}
		>
			{title}
		</h3>

		<p
			class={`mt-0.5 text-sm border-4 p-2 ${descriptionColor} border-[#232322]`}
		>
			{description}
		</p>
	</div>
</li>
