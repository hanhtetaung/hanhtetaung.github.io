---
const { backgroundColor, header, description, logo } = Astro.props;
---

<li
	class="border-4 border-r-8 border-b-8 rounded-xl border-[#232322] lg:p-8 p-4 flex space-x-5 place-items-center"
	style={backgroundColor ? `background-color: ${backgroundColor}` : undefined}
>
	<img src={logo} alt={header} class="w-12 h-12">
	<article class="space-y-1">
		<h3 class="text-lg font-semibold">{header}</h3>
		<p class="text-md">{description}</p>
	</article>
</li>
