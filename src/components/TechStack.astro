---
import TechStackCard from "@components/TechStackCard.astro";
import AstroLogo from "../images/astro.svg";
import BunLogo from "../images/bun.svg";
import CloudflareLogo from "../images/cloudflare.svg";
import GitHubLogo from "../images/github.svg";
import ReactLogo from "../images/react.svg";
import SpaceshipLogo from "../images/spaceship.svg";
import TailwindLogo from "../images/tailwindcss.svg";
import TypeScriptLogo from "../images/typescript.svg";
---

<section>
	<hr>
	<h1 class="text-4xl font-bold text-center py-2">Tech Stack</h1>
	<hr>
	<ul class="grid grid-cols-2 gap-4 pt-6">
		<TechStackCard
			backgroundColor="#14b5e5"
			header="React"
			description="Use React to build user interfaces."
		>
			<ReactLogo class="w-20 h-20"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#ff8633"
			header="TypeScript"
			description="Use TypeScript to build scalable and maintainable code."
		>
			<TypeScriptLogo class="w-18 h-18"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#d485ea"
			header="Astro"
			description="Use Astro to fast build websites."
		>
			<AstroLogo class="w-20 h-20"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#0ca95b"
			header="Tailwind CSS"
			description="Use Tailwind CSS to rapidly build custom designs."
		>
			<TailwindLogo class="w-20 h-20"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#43d0ad"
			header="Bun"
			description="Use Bun to build fast and modern JavaScript applications."
		>
			<BunLogo class="w-20 h-20"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#a78bfa"
			header="Cloudflare"
			description="Use Cloudflare as a DNS provider for nameservers."
		>
			<CloudflareLogo class="w-30 h-30"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#f38ba3"
			header="GitHub"
			description="Use GitHub to host and version control your code."
		>
			<GitHubLogo class="w-20 h-20"/>
		</TechStackCard>

		<TechStackCard
			backgroundColor="#fefc78"
			header="Spaceship"
			description="Use Spaceship to buy domains."
		>
			<SpaceshipLogo class="w-20 h-20"/>
		</TechStackCard>
	</ul>
</section>
