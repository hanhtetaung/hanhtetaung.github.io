---
import CardStack from "@components/base/CardStack.tsx";
---

<section class="relative">
	<div
		id="tools-sticky-bar"
		class="sticky top-0 z-10 bg-[#fefbf6] py-1 transition-[visibility,opacity,transform] duration-300 ease-out [&.tools-sticky-bar--hidden]:invisible [&.tools-sticky-bar--hidden]:opacity-0 [&.tools-sticky-bar--hidden]:-translate-y-full"
	>
		<hr>
		<h1 class="text-2xl lg:text-4xl font-bold text-center py-2">Tools</h1>
		<hr>
	</div>

	<CardStack client:load/>

	<script>
	const bar = document.getElementById("tools-sticky-bar");
	if (bar) {
		window.addEventListener("tools-sticky-bar", (e) => {
			const detail = (e as CustomEvent<{ hide?: boolean }>).detail;
			if (detail?.hide) {
				bar.classList.add("tools-sticky-bar--hidden");
			} else {
				bar.classList.remove("tools-sticky-bar--hidden");
			}
		});
	}
	</script>
</section>
